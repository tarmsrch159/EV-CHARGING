# Server Configuration
PORT=9100
IS_PROD=false

# Session Secrets
SESSION_SECRET_1=your_session_secret_1
SESSION_SECRET_2=your_session_secret_2
SESSION_SECRET_EXPRESS=your_express_session_secret

# Database Connection (Direct overrides)
# DB_HOST=
# DB_PORT=
# DB_USER=
# DB_PASSWORD=
# DB_DATABASE=

# Database Connection (SIT/QA)
DB_HOST_SIT=your_sit_db_host
DB_PORT_SIT=5432
DB_USER_SIT=your_sit_db_user
DB_PASSWORD_SIT=your_sit_db_password
DB_DATABASE_SIT=tms_aos01

# Database Connection (PROD)
DB_HOST_PROD=your_prod_db_host
DB_PORT_PROD=5432
DB_USER_PROD=your_prod_db_user
DB_PASSWORD_PROD=your_prod_db_password
DB_DATABASE_PROD=tms_aos_qa

# Database Prefix
DB_PREFIX=tms_

# Authorization Tokens
AUTH_WEBSITE=Basic your_base64_encoded_website_auth
AUTH_MOBILE=Basic your_base64_encoded_mobile_auth

# Upload File Paths
UPLOAD_PATH_DEV=files
UPLOAD_PATH_PROD=files

# Mail Configuration (SIT/QA)
MAIL_HOST_SIT=your_sit_mail_host
MAIL_PORT_SIT=587
MAIL_SECURE_SIT=false
MAIL_USER_SIT=your_sit_mail_user
MAIL_PASS_SIT=your_sit_mail_password
MAIL_FROM_SIT="AOS System (SIT)" <noreply@example.com>

# Mail Configuration (PROD)
MAIL_HOST_PROD=your_prod_mail_host
MAIL_PORT_PROD=25
MAIL_SECURE_PROD=false
MAIL_USER_PROD=your_prod_mail_user
MAIL_PASS_PROD=your_prod_mail_password
MAIL_FROM_PROD="AOS System" <noreply@example.com>

# Scheduler License Codes (comma separated)
LIC_CODES=aos01
